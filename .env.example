# Start self-hosted Langfuse first; create a project and copy its keys here.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true
# Optional override; each service has its own name by default.
OTEL_SERVICE_NAME=
SPECIALIST_URL=http://127.0.0.1:8001
SPECIALIST_TIMEOUT_SECONDS=10
# Optional real ADK demo only:
GOOGLE_API_KEY=
ADK_MODEL=gemini-2.5-flash
